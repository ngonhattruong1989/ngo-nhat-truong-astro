---
interface Props { title: string; active?: string; }
const { title, active = '' } = Astro.props;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Ngô Nhật Trường CMS</title>
    <style is:global>
      :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;color:#17212b;background:#f5f6f4;font-synthesis:none}*{box-sizing:border-box}body{margin:0;min-height:100vh}a{color:inherit;text-decoration:none}button,input,textarea{font:inherit}.topbar{height:64px;background:#142019;color:#f6f4ed;display:flex;align-items:center;justify-content:space-between;padding:0 28px}.brand{font-weight:700;letter-spacing:.02em}.top-actions{display:flex;align-items:center;gap:18px}.top-actions a{color:#d7dfd8;font-size:13px}.shell{display:grid;grid-template-columns:250px minmax(0,1fr);min-height:calc(100vh - 64px)}.sidebar{background:#fff;border-right:1px solid #e5e9e5;padding:24px 14px;display:flex;flex-direction:column;gap:22px}.side-label{font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:#87928a;padding:0 12px 8px}.nav-link{display:block;border-radius:8px;padding:10px 12px;font-size:14px;color:#4d5a50}.nav-link:hover,.nav-link.active{background:#edf2ed;color:#203f2c;font-weight:650}.side-foot{margin-top:auto;color:#849087;font-size:11px;line-height:1.6;padding:12px}.main{padding:34px clamp(18px,4vw,56px);max-width:1500px;width:100%}.page-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:24px}.eyebrow{font-size:11px;color:#78847b;text-transform:uppercase;letter-spacing:.12em}.page-head h1{font-size:28px;margin:6px 0;font-weight:650}.subtle{color:#718078;font-size:14px}.card{background:#fff;border:1px solid #e5e9e5;border-radius:12px;padding:22px;box-shadow:0 2px 8px #18221a08}.section-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.section-card{display:block;padding:20px;border:1px solid #e5e9e5;background:#fff;border-radius:12px;transition:.15s}.section-card:hover{border-color:#a9b9aa;transform:translateY(-2px)}.section-card strong{display:block;margin-bottom:7px}.section-card span{font-size:12px;color:#718078}.button{border:0;border-radius:8px;background:#203f2c;color:#fff;padding:10px 15px;font-weight:600;cursor:pointer}.button:hover{background:#2b563b}.button.secondary{background:#e8ece8;color:#27372b}.button.danger{background:#f9e8e5;color:#8c2e24}.editor-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.locale-tabs{display:flex;gap:7px}.locale-tab{border:1px solid #dce2dc;background:#fff;border-radius:7px;padding:8px 13px;cursor:pointer}.locale-tab.active{background:#203f2c;color:#fff;border-color:#203f2c}.fields{display:grid;gap:12px}.field{display:grid;gap:7px;margin:8px 0}.field>label,.field-label{font-size:12px;font-weight:650;color:#516057}.field input,.field textarea{width:100%;border:1px solid #dce2dc;border-radius:7px;padding:10px;background:#fff;color:#17212b}.field textarea{min-height:95px;resize:vertical;line-height:1.5}.object-card,.array-item{border:1px solid #e6ebe6;border-radius:9px;padding:15px;margin:10px 0;background:#fcfdfc}.object-card>summary{font-weight:650;cursor:pointer}.array-heading{display:flex;justify-content:space-between;align-items:center;font-weight:650;margin:12px 0 6px}.field-tools{display:flex;gap:7px;flex-wrap:wrap}.small-button{font-size:12px;padding:6px 9px;border:1px solid #dce2dc;background:#fff;border-radius:6px;cursor:pointer}.status{padding:11px 13px;border-radius:8px;margin:12px 0;font-size:13px;display:none}.status.ok{display:block;background:#e8f5eb;color:#205a32}.status.error{display:block;background:#fff0ed;color:#8c2e24}.login-wrap{min-height:100vh;display:grid;place-items:center;padding:20px}.login-card{width:min(430px,100%)}.login-card h1{margin:8px 0 4px}.login-card form{display:grid;gap:14px;margin-top:24px}.login-card input{padding:12px;border:1px solid #dce2dc;border-radius:8px}.help{font-size:12px;color:#77847b;line-height:1.6}@media(max-width:760px){.topbar{padding:0 16px}.shell{grid-template-columns:1fr}.sidebar{padding:10px;display:flex;flex-direction:row;overflow:auto;border-right:0;border-bottom:1px solid #e5e9e5;gap:4px}.side-label,.side-foot{display:none}.nav-link{white-space:nowrap;padding:9px}.main{padding:24px 14px}.page-head{flex-direction:column}.editor-top{align-items:flex-start;flex-direction:column}}
    </style>
  </head>
  <body>
    <header class="topbar"><a class="brand" href="/admin">NGÔ NHẬT TRƯỜNG <span style="font-weight:400;color:#bdc9bf">/ CMS</span></a><div class="top-actions"><a href="/" target="_blank" rel="noreferrer">Mở website ↗</a><form method="POST" action="/api/auth/logout"><button class="button secondary" type="submit">Đăng xuất</button></form></div></header>
    <div class="shell"><aside class="sidebar"><div><div class="side-label">Quản lý nội dung</div><a class={`nav-link ${active === 'dashboard' ? 'active' : ''}`} href="/admin">Tổng quan</a><a class={`nav-link ${active === 'about' ? 'active' : ''}`} href="/admin/about">Về tôi</a><a class={`nav-link ${active === 'films' ? 'active' : ''}`} href="/admin/films">Phim</a><a class={`nav-link ${active === 'music' ? 'active' : ''}`} href="/admin/music">Nhạc</a><a class={`nav-link ${active === 'paintings' ? 'active' : ''}`} href="/admin/paintings">Tranh</a><a class={`nav-link ${active === 'poetry' ? 'active' : ''}`} href="/admin/poetry">Thơ</a><a class={`nav-link ${active === 'artwork' ? 'active' : ''}`} href="/admin/artwork">Artwork</a><a class={`nav-link ${active === 'spaces' ? 'active' : ''}`} href="/admin/spaces">Không gian</a><a class={`nav-link ${active === 'blog' ? 'active' : ''}`} href="/admin/blog">Blog</a><a class={`nav-link ${active === 'contact' ? 'active' : ''}`} href="/admin/contact">Liên hệ</a><a class={`nav-link ${active === 'ui-translations' ? 'active' : ''}`} href="/admin/ui-translations">Bản dịch giao diện</a></div><div class="side-foot">CMS riêng · Nội dung Việt / English / Français</div></aside><main class="main"><slot /></main></div>
  </body>
</html>
