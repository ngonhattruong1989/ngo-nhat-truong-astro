---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { CMS_SECTIONS, SECTION_DATA, getSectionData } from '../../lib/cms/content.mjs';
export const prerender = false;
const section = Astro.params.section || '';
const labels = { about: 'Về tôi', artwork: 'Artwork', blog: 'Blog', contact: 'Liên hệ', films: 'Phim', music: 'Nhạc', paintings: 'Tranh', poetry: 'Thơ', spaces: 'Không gian', 'ui-translations': 'Bản dịch giao diện' };
if (!CMS_SECTIONS.includes(section)) return Astro.redirect('/admin');
const title = labels[section] || section;
const initialData = await getSectionData(section, env.DB);
---
<AdminLayout title={`Chỉnh sửa ${title}`} active={section}>
  <div class="page-head"><div><div class="eyebrow">Quản lý nội dung / {title}</div><h1>{title}</h1><p class="subtle">Chỉnh sửa nội dung cho từng ngôn ngữ. Các trường bổ sung cũng được giữ nguyên khi lưu.</p></div><a class="button secondary" href="/admin">← Tổng quan</a></div>
  <section class="card">
    <div class="editor-top"><div class="locale-tabs" role="tablist" aria-label="Ngôn ngữ"><button class="locale-tab active" data-locale="vi">Tiếng Việt</button><button class="locale-tab" data-locale="en">English</button><button class="locale-tab" data-locale="fr">Français</button></div><div class="field-tools"><button id="reload" class="button secondary" type="button">Tải lại</button><button id="save" class="button" type="button">Lưu thay đổi</button></div></div>
    <div id="status" class="status" role="status"></div><div id="fields" class="fields"></div>
  </section>
</AdminLayout>
<script define:vars={{ initialData, section }}>
  let draft = structuredClone(initialData);
  let locale = 'vi';
  const fields = document.getElementById('fields');
  const status = document.getElementById('status');
  const labels = { title:'Tiêu đề', layout:'Kiểu hiển thị', description:'Mô tả', items:'Nội dung', id:'ID / slug', thumbnail:'Ảnh đại diện', images:'Ảnh', poster:'Poster', stills:'Ảnh tĩnh', bts:'Hậu trường', youtubeId:'YouTube ID', genre:'Thể loại', year:'Năm', duration:'Thời lượng', crew:'Ê-kíp / credit', medium:'Chất liệu', date:'Ngày', excerpt:'Trích dẫn', content:'Nội dung', tagline:'Tagline', menu:'Menu', footer:'Footer', homeWelcome:'Lời chào trang chủ' };
  const labelFor = (key) => labels[key] || key.replace(/([A-Z])/g, ' $1').replace(/^./, (c) => c.toUpperCase());
  function pathSet(path, value) { let target = draft; for (const key of path.slice(0, -1)) target = target[key]; target[path.at(-1)] = value; }
  function blankLike(value) { if (Array.isArray(value)) return []; if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value).map(([k,v]) => [k, blankLike(v)])); if (typeof value === 'boolean') return false; if (typeof value === 'number') return 0; return ''; }
  function addArrayItem(path, array) { const template = array[0]; const fresh = template === undefined ? '' : blankLike(template); pathSet(path, [...array, fresh]); render(); }
  function node(value, key, path) {
    const wrap = document.createElement('div');
    if (Array.isArray(value)) {
      const heading = document.createElement('div'); heading.className = 'array-heading';
      const name = document.createElement('span'); name.textContent = `${labelFor(key)} (${value.length})`;
      const add = document.createElement('button'); add.type='button'; add.className='small-button'; add.textContent='+ Thêm mục'; add.addEventListener('click',()=>addArrayItem(path,value)); heading.append(name,add); wrap.append(heading);
      value.forEach((item,index)=>{
        const card=document.createElement('div');card.className='array-item';
        const tools=document.createElement('div');tools.className='field-tools';
        const title=document.createElement('strong');title.textContent=`${labelFor(key)} ${index+1}`;tools.append(title);
        const remove=document.createElement('button');remove.type='button';remove.className='small-button';remove.textContent='Xóa';remove.addEventListener('click',()=>{pathSet(path,value.filter((_,i)=>i!==index));render();});tools.append(remove);
        if(index>0){const up=document.createElement('button');up.type='button';up.className='small-button';up.textContent='↑';up.addEventListener('click',()=>{const next=[...value];[next[index-1],next[index]]=[next[index],next[index-1]];pathSet(path,next);render();});tools.append(up);}
        if(index<value.length-1){const down=document.createElement('button');down.type='button';down.className='small-button';down.textContent='↓';down.addEventListener('click',()=>{const next=[...value];[next[index],next[index+1]]=[next[index+1],next[index]];pathSet(path,next);render();});tools.append(down);}
        card.append(tools);card.append(node(item,`${key} ${index+1}`,[...path,index]));wrap.append(card);
      });
      return wrap;
    }
    if (value && typeof value === 'object') {
      const details=document.createElement('details');details.className='object-card';details.open=path.length<2;
      const summary=document.createElement('summary');summary.textContent=labelFor(key);details.append(summary);
      for(const [childKey,child] of Object.entries(value)){const childWrap=node(child,childKey,[...path,childKey]);details.append(childWrap);}
      wrap.append(details);return wrap;
    }
    const field=document.createElement('div');field.className='field';const label=document.createElement('label');label.textContent=labelFor(key);field.append(label);
    let control;
    if(typeof value==='boolean'){control=document.createElement('input');control.type='checkbox';control.checked=value;control.addEventListener('change',()=>pathSet(path,control.checked));}
    else if(typeof value==='number'){control=document.createElement('input');control.type='number';control.value=String(value);control.addEventListener('input',()=>pathSet(path,control.value===''?0:Number(control.value)));}
    else {control=document.createElement('textarea');control.value=value??'';control.rows=String(value??'').length>100?8:3;control.addEventListener('input',()=>pathSet(path,control.value));}
    field.append(control);
    if(path.some((part)=>['thumbnail','poster','images','stills','bts'].includes(String(part)))){const upload=document.createElement('input');upload.type='file';upload.accept='image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm';upload.setAttribute('aria-label',`Tải ${labelFor(key)}`);upload.addEventListener('change',async()=>{const file=upload.files?.[0];if(!file)return;const form=new FormData();form.append('file',file);try{const res=await fetch('/api/cms/upload',{method:'POST',body:form});const body=await res.json();if(!res.ok)throw new Error(body.error||'Upload thất bại');pathSet(path,body.url);control.value=body.url;show('Đã tải media lên. Hãy lưu thay đổi để áp dụng.',true);}catch(error){show(error.message,false);}finally{upload.value='';}});field.append(upload);}
    wrap.append(field);return wrap;
  }
  function render(){fields.replaceChildren();const data=draft[locale];for(const [key,value] of Object.entries(data)){fields.append(node(value,key,[locale,key]));}}
  function show(message,ok){status.textContent=message;status.className=`status ${ok?'ok':'error'}`;}
  document.querySelectorAll('.locale-tab').forEach(button=>button.addEventListener('click',()=>{locale=button.dataset.locale;document.querySelectorAll('.locale-tab').forEach(tab=>tab.classList.toggle('active',tab===button));render();}));
  document.getElementById('save').addEventListener('click',async(event)=>{const button=event.currentTarget;button.disabled=true;button.textContent='Đang lưu…';try{const response=await fetch(`/api/cms/${encodeURIComponent(section)}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(draft)});const result=await response.json();if(!response.ok)throw new Error(result.error||'Không thể lưu');show('Đã lưu. Nội dung website được cập nhật ngay.',true);}catch(error){show(error.message,false);}finally{button.disabled=false;button.textContent='Lưu thay đổi';}});
  document.getElementById('reload').addEventListener('click',async()=>{if(!confirm('Tải lại sẽ bỏ các chỉnh sửa chưa lưu. Tiếp tục?'))return;try{const response=await fetch(`/api/cms/${encodeURIComponent(section)}`,{cache:'no-store'});if(!response.ok)throw new Error('Không thể tải dữ liệu');draft=await response.json();render();show('Đã tải lại nội dung.',true);}catch(error){show(error.message,false);}});
  render();
</script>
