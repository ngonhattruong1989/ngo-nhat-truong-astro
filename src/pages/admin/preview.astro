---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSectionData } from '../../lib/cms/content.mjs';
import { previewPageHTML } from '../../lib/render.mjs';

export const prerender = false;

const url = Astro.url;
const section = url.searchParams.get('section') || '';
const id = url.searchParams.get('id') || '';
const locale = url.searchParams.get('locale') || 'vi';
const data = section ? await getSectionData(section, env.DB) : null;
const payload = (data && (data[locale] || data.vi)) || {};
const initial = data ? previewPageHTML({ section, payload, itemId: id, locale }) : '';
---

<BaseLayout title="Preview">
  <div class="preview-stage">
    <div class="wrapper">
      <div class="content preview-content" id="preview-root" set:html={initial}></div>
    </div>
  </div>

  <script>
    import { previewPageHTML } from '../../lib/render.mjs';

    const root = document.getElementById('preview-root');

    // CMS đẩy bản nháp (chưa lưu) sang; luôn render bằng CSS và markup của website thật.
    window.addEventListener('message', (event) => {
      if (event.origin !== location.origin) return;
      const message = event.data;
      if (!message || message.type !== 'cms:preview' || !root) return;
      root.innerHTML = previewPageHTML({
        section: message.section || '',
        payload: message.payload || {},
        itemId: message.itemId || message.id || '',
        locale: message.locale || 'vi',
      });
      window.scrollTo({ top: 0, behavior: 'auto' });
    });

    parent.postMessage({ type: 'cms:preview-ready' }, location.origin);
  </script>
</BaseLayout>
