---
export const prerender = false;
---
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đăng nhập CMS · Ngô Nhật Trường</title><style>body{margin:0;background:#f4f6f3;color:#17212b;font-family:system-ui,sans-serif}.login-wrap{min-height:100vh;display:grid;place-items:center;padding:20px}.login-card{width:min(420px,100%);padding:32px;background:white;border:1px solid #e2e8e2;border-radius:14px;box-shadow:0 8px 32px #17212b10}.eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#758178}.login-card h1{font-size:26px;margin:8px 0}.login-card p{color:#68766c;font-size:14px;line-height:1.6}.login-card form{display:grid;gap:12px;margin-top:24px}.login-card label{font-size:13px;font-weight:600}.login-card input{box-sizing:border-box;width:100%;padding:12px;border:1px solid #d8e0d8;border-radius:8px;margin-top:6px}.login-card button{background:#203f2c;color:white;border:0;border-radius:8px;padding:12px;font-weight:650;cursor:pointer}.error{color:#a13227;background:#fff0ed;padding:10px;border-radius:7px;font-size:13px;display:none}</style></head><body><main class="login-wrap"><section class="login-card"><div class="eyebrow">Ngô Nhật Trường · CMS</div><h1>Đăng nhập</h1><p>Đăng nhập để quản lý nội dung website bằng ba ngôn ngữ.</p><div id="error" class="error" role="alert"></div><form id="login"><label>Tên đăng nhập<input name="username" autocomplete="username" required></label><label>Mật khẩu<input name="password" type="password" autocomplete="current-password" required></label><button type="submit">Vào trang quản trị</button></form></section></main><script>document.getElementById('login').addEventListener('submit',async(e)=>{e.preventDefault();const form=e.currentTarget;const response=await fetch('/api/auth/login',{method:'POST',body:new FormData(form)});const result=await response.json();if(response.ok&&result.success){location.assign('/admin');return}const error=document.getElementById('error');error.textContent=result.error||'Không thể đăng nhập.';error.style.display='block';});</script></body></html>
